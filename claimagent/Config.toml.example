# Copy this file to Config.toml.
#
# mode = "IN_MEMORY" runs the ballerina/workflow engine (which also hosts
# workflow:DurableAgent) embedded in this process with no external Temporal
# server - same engine, same trade-off, as claimworkflow's Config.toml.example:
# an in-flight agent's state is lost if this process restarts.
[ballerina.workflow]
mode = "IN_MEMORY"

# WSO2 default model provider credentials, used by ai:getDefaultModelProvider().
# Generate these with the Ballerina VS Code extension: open this folder in
# VS Code with the Ballerina extension installed, then run the command
# "Ballerina: Configure Default Model Provider" from the Command Palette.
[ballerina.ai.wso2ProviderConfig]
serviceUrl = "<generated>"
accessToken = "<generated>"

[anupama.claimagent]
mcpServerUrl = "http://localhost:9090/mcp"
servicePort = 8083
